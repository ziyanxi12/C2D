# ── LLM 配置（/match、/batch、/match-dsl 依赖）──────────────────────────────────
DASHSCOPE_API_KEY=sk-01fc3058d8fd453d8a19731b99d3aff7
MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
# 单次 LLM 请求超时（毫秒）。出现 /match 报 "timeout" 时，可先调大这个值排除"网络慢但最终能通"
# 的情况；同时观察 server 端日志里 [match_variant] 打印的每一步耗时，定位卡在哪一步
LLM_TIMEOUT_MS=60000
# 打印每次 LLM 调用的完整输入（messages）和输出（message/tool_calls），用于排查
# "为什么模型选了这个变体/选错了"。默认关闭——开着会把每次调用的完整 prompt 刷进日志，
# 排查时临时改成 true，用完记得关掉
LLM_LOG_IO=false
# LLM_LOG_IO 打开时，单条输入/输出日志超过这个长度会被截断（避免大 prompt 刷屏）
LLM_LOG_IO_MAX_LEN=4000

# ── 多组件库根目录（hex 静态资源所在路径）─────────────────────────────────────
# 不配置时默认指向 ../../pixso-parse/pix-split/lib-out；仅当部署环境需要把这份数据放在
# 别处时才需要取消下面这行的注释并改成实际路径——写在配置文件里就不会在每次启动时忘记带上它
#LIB_OUT_DIR=/path/to/lib-out
