# Embedding 服务（DashScope 兼容模式）
DASHSCOPE_API_KEY=your-key-here
EMBEDDING_BASE_URL=https://mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 组件库输入文件路径
COMPONENT_INDEX_PATH=../component_index.json

# 图标库输入文件路径
ICONS_PATH=./icons.json

# Elasticsearch
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=
ES_INDEX=component_variants
ICON_ES_INDEX=component_icons

# API 服务端口
PORT=3100

# Mock 模式（1=跳过 API，用随机向量）
# MOCK_EMBED=1
