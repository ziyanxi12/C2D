# 组件库 hex 根目录（与 component-service 的 LIB_OUT_DIR 指向同一份数据）。
# 留空则使用默认值 ../../pixso-parse/pix-split/lib-out（相对本目录解析）。
# HEX_LIB_DIR=/abs/path/to/lib-out

# 表格模版 hex 文件路径（相对本目录或绝对路径）。
# 留空则不启用表格功能，table 类型节点输出占位 FRAME。
TABLE_TEMPLATE_PATH=../tableTemplate.txt

# 日志配置
LOG_LEVEL=info
LOG_DIR=~/logs/nodejs
